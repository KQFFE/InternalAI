# Handle line endings automatically for files detected as text
* text=auto eol=lf

# Explicitly declare files that should always have LF line endings
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf

# Declare files that should stay binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary