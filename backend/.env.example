# Environment variables store sensitive settings like passwords that shouldn't be shared in code.
# This is an example file to show what variables are needed.
# Copy this file to .env and fill in your actual values.

# backend/.env.example
# Copy this file to .env and fill in your actual values

# Admin authentication
ADMIN_PASSWORD=your_secure_admin_password_here

# Flask configuration
FLASK_ENV=development

# Optional: Database URL (if you add database later)
# DATABASE_URL=your_database_url_here

# Optional: Secret key (if you want to override default)
# SECRET_KEY=your_secret_key_here