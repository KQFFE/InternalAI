{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "proxy": "http://localhost:5000",
  "dependencies": {
    "@testing-library/dom": "^10.4.0",
    "exceljs": "^4.4.0",
    "papaparse": "^5.3.3",
    "prop-types": "^15.8.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "^6.30.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "craco start",
    "build": "craco build",
    "test": "craco test",
    "eject": "react-scripts eject",
    "test:e2e": "playwright test",
    "test:all": "craco test --watchAll=false"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "plugin:jsx-a11y/strict"
    ],
    "plugins": [
      "jsx-a11y"
    ],
    "rules": {
      "no-unused-vars": "warn"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "nth-check": "2.1.1",
    "css-select": "6.0.0",
    "svgo": "4.0.0",
    "postcss": "8.4.35",
    "webpack-dev-server": "5.2.2"
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "@playwright/test": "^1.53.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "autoprefixer": "^10.4.16",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jest": "^27.5.1",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.0.4",
    "react-scripts": "^5.0.1",
    "tailwindcss": "^3.3.7"
  }
}
